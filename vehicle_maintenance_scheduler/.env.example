PORT=3000

# Optional — override the upstream evaluation service base URL
# EVAL_BASE_URL=http://20.207.122.201/evaluation-service

# Credentials are normally read from ../secrets.local.json. These env vars
# override the file values one-by-one if you prefer not to keep a JSON file.
# EVAL_EMAIL=
# EVAL_NAME=
# EVAL_MOBILE=
# EVAL_GITHUB=
# EVAL_ROLLNO=
# EVAL_ACCESS_CODE=
# EVAL_CLIENT_ID=
# EVAL_CLIENT_SECRET=
# EVAL_ACCESS_TOKEN=

# Set to 1 to print middleware errors to stderr (useful while wiring things up)
# LOG_DEBUG=1
